# ---- WordPress target (the NEW website) ----
WP_URL=https://your-new-site.com
WP_USERNAME=your_wp_user
WP_PASSWORD=your_wp_application_password

# ---- Google Sheets control sheet for this site ----
# Make a copy of the "SEO Flow" spreadsheet and put its key here.
SEO_SHEET_ID=
SEO_SHEET_NAME=SEO Flow

# ---- LLM / image API keys ----
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Optional: override log directory (defaults to <project>/logs) ----
# LOG_DIR=/var/log/seo_agents

# ---- Optional: Google Vertex image gen ----
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
